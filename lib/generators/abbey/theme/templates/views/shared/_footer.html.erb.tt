<%%# <%= theme_display_name %> theme footer. %>
<footer class="mt-auto border-t border-gray-200 dark:border-gray-800">
  <div class="container mx-auto px-4 py-6 max-w-5xl flex flex-col md:flex-row gap-3 justify-between text-sm text-<%= file_name %>-muted">
    <p>© <%%= Date.today.year %> <%%= Rails.application.config.site_name %></p>
    <p>crafted on
      <a href="https://github.com/capotej/abbey" target="_blank" rel="noopener" class="underline hover:text-<%= file_name %>-accent">abbey</a>
    </p>
  </div>
</footer>
